# Relative to the deployed index.html, or an absolute URL to a Range-enabled COPC host.
# Leave empty for the public Flai overview (reduced detail).
# Set pointclouds/test.copc.laz to use a local file instead.
VITE_POINT_CLOUD_URL=

# OpenStreetMap-compatible XYZ tiles. The default needs no token or API key.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Photon or Nominatim-compatible endpoint. Photon supports the type-ahead search UI.
VITE_GEOCODER_URL=https://photon.komoot.io/api/

# Use /repository-name/ for a known subpath, or leave ./ for a portable static bundle.
VITE_BASE_PATH=./
